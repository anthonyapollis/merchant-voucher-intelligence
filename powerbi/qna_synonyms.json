  "Relationships": {
    "_comment": "Verb phrasings let users ask naturally rather than in field names.",
    "merchant_generates_sales": {
      "Binding": { "ConceptualEntity": "fct_merchant_sales" },
      "State": "Generated",
      "Phrasings": [
        { "Verb": {
            "Subject": { "Role": "dim_merchant" },
            "Verb": "generate|make|produce|earn|bring in",
            "Object": { "Role": "Total Sales" } } }
      ]
    },
    "merchant_raises_tickets": {
      "Binding": { "ConceptualEntity": "fct_support_tickets" },
      "State": "Generated",
